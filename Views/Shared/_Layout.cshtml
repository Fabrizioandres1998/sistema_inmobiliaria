<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - InmobiliariaTPI</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @if (User.Identity.IsAuthenticated)
    {
        <header>

            <nav class="navbar navbar-expand-lg modern-navbar">

                <div class="container-fluid px-4">

                    <!-- LOGO -->
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">

                        <div class="brand-icon">
                            <i class="bi bi-buildings"></i>
                        </div>

                        <span>Inmobiliaria<span class="brand-highlight">TPI</span></span>

                    </a>


                    <!-- BOTÓN MOBILE -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir menú">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <!-- MENÚ -->
                    <div class="collapse navbar-collapse" id="mainNavbar">

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">

                            <li class="nav-item">
                                <a class="nav-link modern-nav-link" asp-controller="Propietarios" asp-action="Index">

                                    <i class="bi bi-person-vcard"></i>
                                    <span>Propietarios</span>

                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link modern-nav-link" asp-controller="Inquilinos" asp-action="Index">

                                    <i class="bi bi-people"></i>
                                    <span>Inquilinos</span>

                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link modern-nav-link" asp-controller="Inmuebles" asp-action="Index">

                                    <i class="bi bi-house"></i>
                                    <span>Inmuebles</span>

                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link modern-nav-link" asp-controller="Reservas" asp-action="Index">

                                    <i class="bi bi-calendar-check"></i>
                                    <span>Reservas</span>

                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link modern-nav-link" asp-controller="Pagos" asp-action="Index">

                                    <i class="bi bi-cash-stack"></i>
                                    <span>Pagos</span>

                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link modern-nav-link" asp-controller="TipoInmueble" asp-action="Index">

                                    <i class="bi bi-grid"></i>
                                    <span>Tipos</span>

                                </a>
                            </li>


                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link modern-nav-link" asp-controller="Usuarios" asp-action="Index">

                                        <i class="bi bi-person-gear"></i>
                                        <span>Usuarios</span>

                                    </a>

                                </li>
                            }

                        </ul>
                        <!-- USUARIO -->
                        <ul class="navbar-nav">

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Usuarios" asp-action="MiPerfil">

                                    <i class="bi bi-person-circle"></i>
                                    @User.Identity.Name

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger fw-semibold" asp-controller="Auth" asp-action="Logout">

                                    <i class="bi bi-box-arrow-right"></i>
                                    Cerrar Sesión

                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </nav>

        </header>
    }


    <!-- CONTENIDO -->

    <main class="main-content">

        <div class="container-fluid px-4 px-lg-5">

            @RenderBody()

        </div>

    </main>


    <!-- FOOTER -->

    @if (User.Identity.IsAuthenticated)
    {
        <footer class="modern-footer">

            <div class="container-fluid px-4 px-lg-5">

                <div class="footer-content">

                    <div>
                        <span class="footer-brand">
                            <i class="bi bi-buildings"></i>
                            InmobiliariaTPI
                        </span>
                    </div>

                    <div>
                        <span>
                            © @DateTime.Now.Year
                        </span>

                        <span class="footer-separator">•</span>

                        <span>
                            Sistema de gestión inmobiliaria
                        </span>
                    </div>

                </div>

            </div>

        </footer>
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
