@model InmobiliariaTPI.Models.Reserva

@{
    ViewData["Title"] = "Eliminar Reserva";
}

<h1>Eliminar Reserva</h1>

<div class="alert alert-danger">
    <h3>¿Estás seguro de eliminar esta reserva?</h3>
    <p>Esta acción no se puede deshacer.</p>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Id)</dd>

        <dt class="col-sm-3">Inmueble</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.IdInmueble)</dd>

        <dt class="col-sm-3">Inquilino</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.IdInquilino)</dd>

        <dt class="col-sm-3">Fecha Inicio</dt>
        <dd class="col-sm-9">@Model.FechaInicio.ToShortDateString()</dd>

        <dt class="col-sm-3">Fecha Fin</dt>
        <dd class="col-sm-9">@Model.FechaFin.ToShortDateString()</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            @if (Model.Estado == "Activa")
            {
                <span class="badge bg-success">Activa</span>
            }
            else if (Model.Estado == "Finalizada")
            {
                <span class="badge bg-secondary">Finalizada</span>
            }
            else
            {
                <span class="badge bg-danger">Cancelada</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>