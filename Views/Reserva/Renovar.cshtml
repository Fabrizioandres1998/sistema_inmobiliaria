@model InmobiliariaTPI.Models.Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<h1>Renovar Reserva</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Renovar" method="post">
            <input type="hidden" asp-for="IdInmueble" />
            <input type="hidden" asp-for="IdInquilino" />
            <input type="hidden" asp-for="IdUsuarioCreador" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="alert alert-info">
                <p><strong>Inmueble:</strong> @ViewBag.InmuebleNombre</p>
                <p><strong>Inquilino:</strong> @ViewBag.InquilinoNombre</p>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" class="form-control" type="date" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MontoPorDia" class="control-label"></label>
                <input asp-for="MontoPorDia" class="form-control" />
                <span asp-validation-for="MontoPorDia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Renovar" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}