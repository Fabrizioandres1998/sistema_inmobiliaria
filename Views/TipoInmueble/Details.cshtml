@model InmobiliariaTPI.Models.TipoInmueble

@{
    ViewData["Title"] = "Detalles del Tipo de Inmueble";
}

<h1>Detalles del Tipo de Inmueble</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Id)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Id)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Nombre)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Descripcion)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Descripcion)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>