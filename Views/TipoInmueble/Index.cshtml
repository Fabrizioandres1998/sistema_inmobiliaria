@model IPagedList<InmobiliariaTPI.Models.TipoInmueble>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="app-tipos">

    <div class="page-header">
        <div>
            <h1 class="page-title">Tipos de Inmueble</h1>
            <p class="page-subtitle">Gestion de categorias de inmuebles</p>
        </div>
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Crear Nuevo Tipo
            </a>
        </div>
    </div>

    <div class="card filter-card">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0" placeholder="Buscar por nombre o descripcion..."
                       v-model="busqueda" />
                <button type="button" class="btn btn-outline-secondary" v-if="busqueda" @@click="busqueda = ''">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().Id)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Descripcion)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr v-if="coincide('@item.Nombre', '@item.Descripcion')">
                            <td class="text-muted">#@item.Id</td>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Nombre)</td>
                            <td class="text-muted">@Html.DisplayFor(modelItem => item.Descripcion)</td>
                            <td class="text-nowrap text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-warning"
                                   title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-info"
                                   title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-danger"
                                       title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(Model, page => Url.Action("Index", new
        {
            page,
            pageSize = Model.PageSize,
            searchTerm = ViewBag.SearchTerm
        }),
            new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
    </div>

</div>

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }

        .page-subtitle {
            color: #868e96;
            font-size: 0.9rem;
            margin: 0;
        }

        .page-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .filter-card,
        .table-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .filter-card .card-body {
            padding: 16px;
        }

        .table-card {
            overflow: hidden;
        }

        .table-card .table {
            margin: 0;
        }

        .table-card .table thead th {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            color: #6c757d;
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 14px 16px;
            border-top: none;
        }

        .table-card .table tbody td {
            padding: 14px 16px;
            border-color: #f1f3f5;
            font-size: 0.9rem;
            vertical-align: middle;
        }

        .table-card .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            margin-left: 3px;
            border: none;
            color: #ffffff;
            transition: all 0.15s ease;
        }

        .btn-icon:hover {
            transform: translateY(-1px);
            color: #ffffff;
        }

        .btn-icon.btn-warning {
            background-color: #ffc107;
        }

        .btn-icon.btn-warning:hover {
            background-color: #e0a800;
        }

        .btn-icon.btn-info {
            background-color: #0dcaf0;
        }

        .btn-icon.btn-info:hover {
            background-color: #0aa2c0;
        }

        .btn-icon.btn-danger {
            background-color: #dc3545;
        }

        .btn-icon.btn-danger:hover {
            background-color: #b02a37;
        }

        .page-link {
            border-radius: 8px;
            margin: 0 3px;
            color: #495057;
            border: 1px solid #e9ecef;
        }

        .page-link:hover {
            background-color: #f1f3f5;
            color: #0d6efd;
        }

        .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    busqueda: ''
                }
            },
            methods: {
                coincide(nombre, descripcion) {
                    if (!this.busqueda) return true;
                    const term = this.busqueda.toLowerCase().trim();
                    return (nombre && nombre.toLowerCase().includes(term)) ||
                        (descripcion && descripcion.toLowerCase().includes(term));
                }
            }
        }).mount('#app-tipos');
    </script>
}