@model IPagedList<InmobiliariaTPI.Models.Inmueble>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Inmuebles";
    bool soloDisponibles = ViewBag.SoloDisponibles ?? false;
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="app-inmuebles">
    <h1>Inmuebles</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary" title="Crear Nuevo Inmueble">
            <i class="bi bi-plus-circle"></i> Crear Nuevo Inmueble
        </a>

        <button type="button" class="btn" :class="soloDisponibles ? 'btn-secondary' : 'btn-success'"
            @@click="toggleDisponibles">
            <i class="bi" :class="soloDisponibles ? 'bi-list' : 'bi-check-circle'"></i>
            {{ soloDisponibles ? 'Ver Todos' : 'Ver Disponibles' }}
        </button>
    </p>

    <div class="input-group mb-3">
        <input type="text" class="form-control"
               placeholder="Buscar por dirección, tipo de inmueble o nombre de propietario..." v-model="busqueda" />
        <button type="button" class="btn btn-outline-secondary" v-if="busqueda" @@click="busqueda = ''">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th class="text-nowrap">ID</th>
                    <th class="text-nowrap">Dirección</th>
                    <th class="text-nowrap">Cupo</th>
                    <th class="text-nowrap">Precio/Día</th>
                    <th class="text-nowrap">Estado</th>
                    <th class="text-nowrap">Propietario</th>
                    <th class="text-nowrap">Tipo</th>
                    <th class="text-nowrap">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr
                        v-if="coincide('@item.Direccion', '@item.Propietario?.NombreCompleto', '@item.TipoInmueble?.Nombre')">
                        <td>@item.Id</td>
                        <td>@item.Direccion</td>
                        <td>@item.CupoMaximo</td>
                        <td>@item.PrecioPorDia.ToString("N2")</td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Suspendido</span>
                            }
                        </td>
                        <td>@item.Propietario?.NombreCompleto</td>
                        <td>@item.TipoInmueble?.Nombre</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info"
                               title="Ver detalles">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (item.Disponible)
                            {
                                <a asp-action="Suspender" asp-route-id="@item.Id" class="btn btn-sm btn-warning"
                                   title="Suspender">
                                    <i class="bi bi-pause-circle"></i>
                                </a>
                            }
                            else
                            {
                                <a asp-action="Activar" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Activar">
                                    <i class="bi bi-play-circle"></i>
                                </a>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new
        {
            page,
            pageSize = Model.PageSize,
            searchTerm = ViewBag.SearchTerm,
            soloDisponibles = ViewBag.SoloDisponibles
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    busqueda: '@Html.Raw(ViewBag.SearchTerm ?? "")',
                    soloDisponibles: @(soloDisponibles ? "true" : "false")
                    }
            },
            methods: {
                coincide(direccion, propietario, tipo) {
                    if (!this.busqueda) return true;
                    const term = this.busqueda.toLowerCase().trim();
                    return (direccion && direccion.toLowerCase().includes(term)) ||
                        (propietario && propietario.toLowerCase().includes(term)) ||
                        (tipo && tipo.toLowerCase().includes(term));
                },
                toggleDisponibles() {
                    this.soloDisponibles = !this.soloDisponibles;
                    const url = new URL(window.location.href);
                    url.searchParams.set('soloDisponibles', this.soloDisponibles);
                    url.searchParams.set('searchTerm', this.busqueda);
                    window.location.href = url.toString();
                }
            }
        }).mount('#app-inmuebles');
    </script>
}