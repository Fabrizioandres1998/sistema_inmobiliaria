@model IPagedList<InmobiliariaTPI.Models.Inmueble>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Inmuebles";
    bool soloDisponibles = ViewBag.SoloDisponibles ?? false;
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="app-inmuebles">

    <div class="page-header">
        <div>
            <h1 class="page-title">Inmuebles</h1>
            <p class="page-subtitle">Gestion de propiedades registradas</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-outline-secondary"
                    :class="soloDisponibles ? 'active' : ''"
                    @@click="toggleDisponibles">
                <i class="bi" :class="soloDisponibles ? 'bi-list' : 'bi-check-circle'"></i>
                {{ soloDisponibles ? 'Ver Todos' : 'Ver Disponibles' }}
            </button>
            <a asp-action="Create" class="btn btn-primary" title="Crear Nuevo Inmueble">
                <i class="bi bi-plus-circle"></i> Crear Nuevo Inmueble
            </a>
        </div>
    </div>

    <div class="card filter-card">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0"
                       placeholder="Buscar por direccion, tipo de inmueble o nombre de propietario..."
                       v-model="busqueda" />
                <button type="button" class="btn btn-outline-secondary" v-if="busqueda" @@click="busqueda = ''">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-nowrap">ID</th>
                        <th class="text-nowrap">Direccion</th>
                        <th class="text-nowrap">Cupo</th>
                        <th class="text-nowrap">Precio/Dia</th>
                        <th class="text-nowrap">Estado</th>
                        <th class="text-nowrap">Propietario</th>
                        <th class="text-nowrap">Tipo</th>
                        <th class="text-nowrap text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr v-if="coincide('@item.Direccion', '@item.Propietario?.NombreCompleto', '@item.TipoInmueble?.Nombre')">
                            <td class="text-muted">#@item.Id</td>
                            <td class="fw-semibold">@item.Direccion</td>
                            <td>@item.CupoMaximo</td>
                            <td>$@item.PrecioPorDia.ToString("N2")</td>
                            <td>
                                @if (item.Disponible)
                                {
                                    <span class="badge-soft badge-soft-success">
                                        <i class="bi bi-check-circle me-1"></i>Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-soft-danger">
                                        <i class="bi bi-pause-circle me-1"></i>Suspendido
                                    </span>
                                }
                            </td>
                            <td>@item.Propietario?.NombreCompleto</td>
                            <td>@item.TipoInmueble?.Nombre</td>
                            <td class="text-nowrap text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-warning" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-info" title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (item.Disponible)
                                {
                                    <a asp-action="Suspender" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-secondary" title="Suspender">
                                        <i class="bi bi-pause-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Activar" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-success" title="Activar">
                                        <i class="bi bi-play-circle"></i>
                                    </a>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(Model, page => Url.Action("Index", new
        {
            page,
            pageSize = Model.PageSize,
            searchTerm = ViewBag.SearchTerm,
            soloDisponibles = ViewBag.SoloDisponibles
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
    </div>

</div>

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }

        .page-subtitle {
            color: #868e96;
            font-size: 0.9rem;
            margin: 0;
        }

        .page-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .filter-card,
        .table-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .filter-card .card-body {
            padding: 16px;
        }

        .table-card {
            overflow: hidden;
        }

        .table-card .table {
            margin: 0;
        }

        .table-card .table thead th {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            color: #6c757d;
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 14px 16px;
            border-top: none;
        }

        .table-card .table tbody td {
            padding: 14px 16px;
            border-color: #f1f3f5;
            font-size: 0.9rem;
            vertical-align: middle;
        }

        .table-card .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .badge-soft {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-soft-success {
            background-color: #e6f7ed;
            color: #198754;
        }

        .badge-soft-danger {
            background-color: #fdecee;
            color: #dc3545;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            margin-left: 3px;
            border: none;
            color: #ffffff;
            transition: all 0.15s ease;
        }

        .btn-icon:hover {
            transform: translateY(-1px);
            color: #ffffff;
        }

        .btn-icon.btn-warning  { background-color: #ffc107; }
        .btn-icon.btn-warning:hover  { background-color: #e0a800; }
        .btn-icon.btn-info     { background-color: #0dcaf0; }
        .btn-icon.btn-info:hover     { background-color: #0aa2c0; }
        .btn-icon.btn-secondary{ background-color: #6c757d; }
        .btn-icon.btn-secondary:hover{ background-color: #5a6268; }
        .btn-icon.btn-success  { background-color: #198754; }
        .btn-icon.btn-success:hover  { background-color: #146c43; }
        .btn-icon.btn-danger   { background-color: #dc3545; }
        .btn-icon.btn-danger:hover   { background-color: #b02a37; }

        .page-link {
            border-radius: 8px;
            margin: 0 3px;
            color: #495057;
            border: 1px solid #e9ecef;
        }

        .page-link:hover {
            background-color: #f1f3f5;
            color: #0d6efd;
        }

        .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    busqueda: '@Html.Raw(ViewBag.SearchTerm ?? "")',
                    soloDisponibles: @(soloDisponibles ? "true" : "false")
                }
            },
            methods: {
                coincide(direccion, propietario, tipo) {
                    if (!this.busqueda) return true;
                    const term = this.busqueda.toLowerCase().trim();
                    return (direccion && direccion.toLowerCase().includes(term)) ||
                        (propietario && propietario.toLowerCase().includes(term)) ||
                        (tipo && tipo.toLowerCase().includes(term));
                },
                toggleDisponibles() {
                    this.soloDisponibles = !this.soloDisponibles;
                    const url = new URL(window.location.href);
                    url.searchParams.set('soloDisponibles', this.soloDisponibles);
                    url.searchParams.set('searchTerm', this.busqueda);
                    window.location.href = url.toString();
                }
            }
        }).mount('#app-inmuebles');
    </script>
}