@model InmobiliariaTPI.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<div id="app-inmueble">

    <div class="page-header">
        <div>
            <h1 class="page-title">Editar Inmueble</h1>
            <p class="page-subtitle">Modifica los datos del inmueble #@Model?.Id</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="Edit" method="post" @@submit.prevent="guardar">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FechaCreacion" />
        <input type="hidden" name="IdPropietario" :value="inmueble.idPropietario" />
        <input type="hidden" name="IdTipoInmueble" :value="inmueble.idTipoInmueble" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card form-card">
                    <div class="card-header">
                        <i class="bi bi-house me-2"></i>Datos del Inmueble
                    </div>
                    <div class="card-body">

                        <div class="form-group mb-3">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" v-model="inmueble.direccion" />
                            <span class="text-danger small" v-if="errorDireccion">{{ errorDireccion }}</span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CupoMaximo" class="form-label"></label>
                                    <input asp-for="CupoMaximo" class="form-control" type="number"
                                           v-model.number="inmueble.cupoMaximo" />
                                    <span class="text-danger small" v-if="errorCupoMaximo">{{ errorCupoMaximo }}</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="PrecioPorDia" class="form-label"></label>
                                    <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01"
                                           v-model.number="inmueble.precioPorDia" />
                                    <span class="text-danger small" v-if="errorPrecioPorDia">{{ errorPrecioPorDia }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Coordenadas" class="form-label"></label>
                            <input asp-for="Coordenadas" class="form-control"
                                   placeholder="Ej: -34.6037, -58.3816" v-model="inmueble.coordenadas" />
                            <span class="text-danger small" v-if="errorCoordenadas">{{ errorCoordenadas }}</span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImagenPortada" class="form-label"></label>
                            <input asp-for="ImagenPortada" class="form-control" v-model="inmueble.imagenPortada" />
                            <div v-if="inmueble.imagenPortada" class="mt-3">
                                <img :src="inmueble.imagenPortada" alt="Previsualizacion" class="preview-img" />
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="PorcentajeReserva" class="form-label"></label>
                            <input asp-for="PorcentajeReserva" class="form-control" type="number"
                                   v-model.number="inmueble.porcentajeReserva" />
                            <span class="text-danger small" v-if="errorPorcentajeReserva">{{ errorPorcentajeReserva }}</span>
                        </div>

                    </div>
                </div>

                <div class="card form-card mt-4">
                    <div class="card-header">
                        <i class="bi bi-person-vcard me-2"></i>Propietario y Tipo
                    </div>
                    <div class="card-body">

                        <div class="form-group mb-3 position-relative">
                            <label class="form-label">Propietario</label>
                            <input type="text" class="form-control" placeholder="Buscar por nombre..."
                                   v-model="busquedaPropietario"
                                   @@focus="mostrarSugerenciasPropietario = true"
                                   @@blur="cerrarSugerenciasPropietario"
                                   autocomplete="off" />

                            <ul class="list-group position-absolute w-100 shadow suggestion-list"
                                v-if="mostrarSugerenciasPropietario && propietariosFiltrados.length > 0">
                                <li class="list-group-item list-group-item-action"
                                    v-for="p in propietariosFiltrados" :key="p.id"
                                    @@mousedown.prevent="seleccionarPropietario(p)">
                                    {{ p.nombreCompleto }}
                                </li>
                            </ul>

                            <div class="mt-2" v-if="propietarioSeleccionado">
                                <span class="badge-soft badge-soft-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    {{ propietarioSeleccionado.nombreCompleto }}
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-2" @@click="limpiarPropietario">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>

                            <span class="text-danger small d-block" v-if="!inmueble.idPropietario && intentoGuardar">
                                Debe seleccionar un propietario.
                            </span>
                        </div>

                        <div class="form-group mb-0 position-relative">
                            <label class="form-label">Tipo de Inmueble</label>
                            <input type="text" class="form-control" placeholder="Buscar tipo..."
                                   v-model="busquedaTipo"
                                   @@focus="mostrarSugerenciasTipo = true"
                                   @@blur="cerrarSugerenciasTipo"
                                   autocomplete="off" />

                            <ul class="list-group position-absolute w-100 shadow suggestion-list"
                                v-if="mostrarSugerenciasTipo && tiposFiltrados.length > 0">
                                <li class="list-group-item list-group-item-action"
                                    v-for="t in tiposFiltrados" :key="t.id"
                                    @@mousedown.prevent="seleccionarTipo(t)">
                                    {{ t.nombre }}
                                </li>
                            </ul>

                            <div class="mt-2" v-if="tipoSeleccionado">
                                <span class="badge-soft badge-soft-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    {{ tipoSeleccionado.nombre }}
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-2" @@click="limpiarTipo">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>

                            <span class="text-danger small d-block" v-if="!inmueble.idTipoInmueble && intentoGuardar">
                                Debe seleccionar un tipo de inmueble.
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card form-card">
                    <div class="card-header">
                        <i class="bi bi-gear me-2"></i>Opciones
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input asp-for="Disponible" class="form-check-input" type="checkbox"
                                   v-model="inmueble.disponible" />
                            <label asp-for="Disponible" class="form-check-label"></label>
                        </div>
                        <small class="text-muted d-block mt-2">
                            Si esta desactivado, el inmueble no aparecera disponible para reservas.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" :disabled="guardando">
                <i class="bi bi-check-circle me-1"></i>
                {{ guardando ? 'Guardando...' : 'Guardar Cambios' }}
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Cancelar
            </a>
        </div>

    </form>

</div>

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }

        .page-subtitle {
            color: #868e96;
            font-size: 0.9rem;
            margin: 0;
        }

        .form-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
        }

        .form-card .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            padding: 14px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #495057;
        }

        .form-card .card-body {
            padding: 24px;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 6px;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: all 0.15s ease;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
        }

        .preview-img {
            max-height: 150px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }

        .suggestion-list {
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            border-radius: 8px;
            margin-top: 4px;
        }

        .suggestion-list .list-group-item {
            border: none;
            border-bottom: 1px solid #f1f3f5;
            padding: 10px 14px;
            cursor: pointer;
            font-size: 0.88rem;
        }

        .suggestion-list .list-group-item:hover {
            background-color: #f8f9fa;
        }

        .badge-soft {
            display: inline-flex;
            align-items: center;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-soft-success {
            background-color: #e6f7ed;
            color: #198754;
        }

        .form-actions {
            display: flex;
            gap: 8px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    propietarios: @Html.Raw(ViewBag.PropietariosJson ?? "[]"),
                    busquedaPropietario: '',
                    mostrarSugerenciasPropietario: false,
                    propietarioSeleccionado: @Html.Raw(ViewBag.PropietarioActualJson ?? "null"),

                    tipos: @Html.Raw(ViewBag.TiposJson ?? "[]"),
                    busquedaTipo: '',
                    mostrarSugerenciasTipo: false,
                    tipoSeleccionado: @Html.Raw(ViewBag.TipoActualJson ?? "null"),

                    inmueble: {
                        idPropietario: @(Model?.IdPropietario ?? 0),
                        idTipoInmueble: @(Model?.IdTipoInmueble ?? 0),
                        direccion: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Direccion ?? "")),
                        cupoMaximo: @(Model?.CupoMaximo ?? 0),
                        coordenadas: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Coordenadas ?? "")),
                        precioPorDia: @(Model?.PrecioPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                        imagenPortada: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ImagenPortada ?? "")),
                        porcentajeReserva: @(Model?.PorcentajeReserva ?? 0),
                        disponible: @(Model?.Disponible == true ? "true" : "false")
                    },
                    guardando: false,
                    intentoGuardar: false
                }
            },
            computed: {
                propietariosFiltrados() {
                    if (!this.busquedaPropietario) return this.propietarios.slice(0, 30);
                    const term = this.busquedaPropietario.toLowerCase().trim();
                    return this.propietarios
                        .filter(p => p.nombreCompleto.toLowerCase().includes(term))
                        .slice(0, 30);
                },
                tiposFiltrados() {
                    if (!this.busquedaTipo) return this.tipos.slice(0, 30);
                    const term = this.busquedaTipo.toLowerCase().trim();
                    return this.tipos
                        .filter(t => t.nombre.toLowerCase().includes(term))
                        .slice(0, 30);
                },
                errorDireccion() {
                    if (!this.inmueble.direccion) return 'La direccion es obligatoria.';
                    if (this.inmueble.direccion.length > 200) return 'La direccion no puede superar los 200 caracteres.';
                    return '';
                },
                errorCupoMaximo() {
                    if (!this.inmueble.cupoMaximo || this.inmueble.cupoMaximo <= 0) return 'El cupo debe ser mayor a 0.';
                    if (this.inmueble.cupoMaximo > 100) return 'El cupo no puede superar 100.';
                    return '';
                },
                errorPrecioPorDia() {
                    if (!this.inmueble.precioPorDia || this.inmueble.precioPorDia <= 0) return 'El precio debe ser mayor a 0.';
                    return '';
                },
                errorCoordenadas() {
                    if (!this.inmueble.coordenadas) return '';
                    const regex = /^-?[0-9]{1,3}\.[0-9]+,\s*-?[0-9]{1,3}\.[0-9]+$/;
                    if (!regex.test(this.inmueble.coordenadas)) {
                        return 'Las coordenadas deben tener el formato: latitud, longitud (ej: -34.6037, -58.3816).';
                    }
                    return '';
                },
                errorPorcentajeReserva() {
                    if (this.inmueble.porcentajeReserva < 0 || this.inmueble.porcentajeReserva > 100) {
                        return 'El porcentaje debe estar entre 0 y 100.';
                    }
                    return '';
                },
                formularioValido() {
                    return !this.errorDireccion &&
                           !this.errorCupoMaximo &&
                           !this.errorPrecioPorDia &&
                           !this.errorCoordenadas &&
                           !this.errorPorcentajeReserva &&
                           this.inmueble.idPropietario > 0 &&
                           this.inmueble.idTipoInmueble > 0;
                }
            },
            mounted() {
                if (this.propietarioSeleccionado) {
                    this.busquedaPropietario = this.propietarioSeleccionado.nombreCompleto;
                }
                if (this.tipoSeleccionado) {
                    this.busquedaTipo = this.tipoSeleccionado.nombre;
                }
            },
            methods: {
                seleccionarPropietario(p) {
                    this.propietarioSeleccionado = p;
                    this.inmueble.idPropietario = p.id;
                    this.busquedaPropietario = p.nombreCompleto;
                    this.mostrarSugerenciasPropietario = false;
                },
                limpiarPropietario() {
                    this.propietarioSeleccionado = null;
                    this.inmueble.idPropietario = 0;
                    this.busquedaPropietario = '';
                },
                cerrarSugerenciasPropietario() {
                    setTimeout(() => { this.mostrarSugerenciasPropietario = false; }, 150);
                },
                seleccionarTipo(t) {
                    this.tipoSeleccionado = t;
                    this.inmueble.idTipoInmueble = t.id;
                    this.busquedaTipo = t.nombre;
                    this.mostrarSugerenciasTipo = false;
                },
                limpiarTipo() {
                    this.tipoSeleccionado = null;
                    this.inmueble.idTipoInmueble = 0;
                    this.busquedaTipo = '';
                },
                cerrarSugerenciasTipo() {
                    setTimeout(() => { this.mostrarSugerenciasTipo = false; }, 150);
                },
                async guardar() {
                    this.intentoGuardar = true;
                    if (!this.formularioValido) return;

                    this.guardando = true;
                    try {
                        const form = document.querySelector('form');
                        const formData = new FormData(form);
                        formData.set('Id', @(Model?.Id ?? 0));
                        formData.set('IdPropietario', this.inmueble.idPropietario);
                        formData.set('IdTipoInmueble', this.inmueble.idTipoInmueble);
                        formData.set('Direccion', this.inmueble.direccion);
                        formData.set('CupoMaximo', this.inmueble.cupoMaximo);
                        formData.set('Coordenadas', this.inmueble.coordenadas);
                        formData.set('PrecioPorDia', this.inmueble.precioPorDia);
                        formData.set('ImagenPortada', this.inmueble.imagenPortada);
                        formData.set('PorcentajeReserva', this.inmueble.porcentajeReserva);
                        formData.set('Disponible', this.inmueble.disponible);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            const html = await response.text();
                            document.documentElement.innerHTML = html;
                        }
                    } catch (error) {
                        alert('Error de conexion: ' + error.message);
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#app-inmueble');
    </script>
}