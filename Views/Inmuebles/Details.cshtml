@model InmobiliariaTPI.Models.Inmueble

@{
    ViewData["Title"] = "Detalles del Inmueble";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Detalles del Inmueble</h1>
        <p class="page-subtitle">Informacion completa del inmueble #@Model.Id</p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Editar
        </a>
        @if (Model.Disponible)
        {
            <a asp-action="Suspender" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pause-circle"></i> Suspender
            </a>
        }
        else
        {
            <a asp-action="Activar" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bi bi-play-circle"></i> Activar
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-8">
        <div class="card detail-card">
            <div class="card-header">
                <i class="bi bi-house me-2"></i>Informacion del Inmueble
            </div>
            <div class="card-body">
                <dl class="detail-list">

                    <div class="detail-row">
                        <dt>Direccion</dt>
                        <dd>@Model.Direccion</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Cupo maximo</dt>
                        <dd>@Model.CupoMaximo personas</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Precio por dia</dt>
                        <dd class="text-success fw-semibold">$@Model.PrecioPorDia.ToString("N2")</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Porcentaje de reserva</dt>
                        <dd>@Model.PorcentajeReserva%</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Coordenadas</dt>
                        <dd>
                            @if (!string.IsNullOrEmpty(Model.Coordenadas))
                            {
                                <span>@Model.Coordenadas</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin coordenadas</span>
                            }
                        </dd>
                    </div>

                    <div class="detail-row">
                        <dt>Fecha de creacion</dt>
                        <dd>@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Propietario</dt>
                        <dd>@Model.Propietario?.NombreCompleto</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Tipo de inmueble</dt>
                        <dd>@Model.TipoInmueble?.Nombre</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Estado</dt>
                        <dd>
                            @if (Model.Disponible)
                            {
                                <span class="badge-soft badge-soft-success">
                                    <i class="bi bi-check-circle me-1"></i>Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-danger">
                                    <i class="bi bi-pause-circle me-1"></i>Suspendido
                                </span>
                            }
                        </dd>
                    </div>

                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card detail-card">
            <div class="card-header">
                <i class="bi bi-image me-2"></i>Imagen de Portada
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ImagenPortada))
                {
                    <img src="@Model.ImagenPortada" alt="Imagen del inmueble" class="detail-image" />
                }
                else
                {
                    <div class="image-placeholder">
                        <i class="bi bi-image"></i>
                        <p>Sin imagen</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }

        .page-subtitle {
            color: #868e96;
            font-size: 0.9rem;
            margin: 0;
        }

        .page-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .detail-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
        }

        .detail-card .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            padding: 14px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #495057;
        }

        .detail-card .card-body {
            padding: 8px 20px;
        }

        .detail-list {
            margin: 0;
        }

        .detail-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 0;
            border-bottom: 1px solid #f1f3f5;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row dt {
            font-size: 0.85rem;
            font-weight: 500;
            color: #868e96;
            margin: 0;
            flex-shrink: 0;
        }

        .detail-row dd {
            font-size: 0.9rem;
            font-weight: 500;
            color: #212529;
            margin: 0;
            text-align: right;
            word-break: break-word;
        }

        .badge-soft {
            display: inline-flex;
            align-items: center;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-soft-success {
            background-color: #e6f7ed;
            color: #198754;
        }

        .badge-soft-danger {
            background-color: #fdecee;
            color: #dc3545;
        }

        .detail-image {
            max-width: 100%;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }

        .image-placeholder {
            padding: 40px 20px;
            color: #adb5bd;
            text-align: center;
        }

        .image-placeholder i {
            font-size: 3rem;
            display: block;
            margin-bottom: 10px;
        }

        .image-placeholder p {
            margin: 0;
            font-size: 0.85rem;
        }
    </style>
}