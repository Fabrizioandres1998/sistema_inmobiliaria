@{
    ViewData["Title"] = "Inicio";
}

<h1>Bienvenido al Sistema de Inmobiliaria</h1>

<p>Este es el panel principal de la aplicación.</p>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Propietarios</div>
            <div class="card-body">
                <h5 class="card-title">Ir a Propietarios</h5>
                <a asp-controller="Propietarios" asp-action="Index" class="btn btn-light">Ver</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Inquilinos</div>
            <div class="card-body">
                <h5 class="card-title">Ir a Inquilinos</h5>
                <a asp-controller="Inquilinos" asp-action="Index" class="btn btn-light">Ver</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-header">Inmuebles</div>
            <div class="card-body">
                <h5 class="card-title">Ir a Inmuebles</h5>
                <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-light">Ver</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-header">Tipos de Inmueble</div>
            <div class="card-body">
                <h5 class="card-title">Ir a Tipos</h5>
                <a asp-controller="TipoInmueble" asp-action="Index" class="btn btn-light">Ver</a>
            </div>
        </div>
    </div>
</div>