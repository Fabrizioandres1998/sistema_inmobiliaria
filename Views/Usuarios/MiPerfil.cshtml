@model InmobiliariaTPI.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Mi Perfil</h1>
        <p class="page-subtitle">Informacion personal de tu cuenta</p>
    </div>
    <div class="page-actions">
        <a asp-action="EditarMiPerfil" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Editar Perfil
        </a>
        <a asp-action="CambiarPassword" class="btn btn-outline-secondary">
            <i class="bi bi-shield-lock"></i> Cambiar Contrasena
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-4">
        <div class="card profile-card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" alt="Avatar" class="profile-avatar" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        <i class="bi bi-person"></i>
                    </div>
                }
                <h4 class="profile-name">@Model.NombreCompleto</h4>
                <span class="profile-role">
                    @if (Model.Rol.ToString() == "Administrador")
                    {
                        <span class="badge-soft badge-soft-primary">
                            <i class="bi bi-shield-lock me-1"></i>Administrador
                        </span>
                    }
                    else
                    {
                        <span class="badge-soft badge-soft-secondary">
                            <i class="bi bi-person me-1"></i>Empleado
                        </span>
                    }
                </span>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card detail-card">
            <div class="card-header">
                <i class="bi bi-person-vcard me-2"></i>Informacion Personal
            </div>
            <div class="card-body">
                <dl class="detail-list">

                    <div class="detail-row">
                        <dt>Nombre completo</dt>
                        <dd>@Model.NombreCompleto</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Email</dt>
                        <dd>@Model.Email</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Rol</dt>
                        <dd>@Model.Rol</dd>
                    </div>

                    <div class="detail-row">
                        <dt>Fecha de registro</dt>
                        <dd>@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd>
                    </div>

                    @if (Model.FechaUltimaModificacion.HasValue)
                    {
                        <div class="detail-row">
                            <dt>Ultima modificacion</dt>
                            <dd>@Model.FechaUltimaModificacion.Value.ToString("dd/MM/yyyy")</dd>
                        </div>
                    }

                </dl>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }

        .page-subtitle {
            color: #868e96;
            font-size: 0.9rem;
            margin: 0;
        }

        .page-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .profile-card,
        .detail-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
        }

        .profile-card .card-body {
            padding: 32px 20px;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid #e7f1ff;
            margin-bottom: 16px;
        }

        .profile-avatar-placeholder {
            width: 120px;
            height: 120px;
            margin: 0 auto 16px auto;
            background-color: #e7f1ff;
            color: #0d6efd;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
        }

        .profile-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 8px 0;
        }

        .profile-role {
            display: inline-block;
        }

        .detail-card .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            padding: 14px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #495057;
        }

        .detail-card .card-body {
            padding: 8px 20px;
        }

        .detail-list {
            margin: 0;
        }

        .detail-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 0;
            border-bottom: 1px solid #f1f3f5;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row dt {
            font-size: 0.85rem;
            font-weight: 500;
            color: #868e96;
            margin: 0;
            flex-shrink: 0;
        }

        .detail-row dd {
            font-size: 0.9rem;
            font-weight: 500;
            color: #212529;
            margin: 0;
            text-align: right;
            word-break: break-word;
        }

        .badge-soft {
            display: inline-flex;
            align-items: center;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-soft-primary {
            background-color: #e7f1ff;
            color: #0d6efd;
        }

        .badge-soft-secondary {
            background-color: #eef0f2;
            color: #6c757d;
        }
    </style>
}