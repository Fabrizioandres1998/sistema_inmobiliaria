@{
    ViewData["Title"] = "Cambiar Contrasena";
}

<div id="app-cambiar-password">

    <div class="page-header">
        <div>
            <h1 class="page-title">Cambiar Contrasena</h1>
            <p class="page-subtitle">Actualiza tu contrasena de acceso al sistema</p>
        </div>
        <a asp-action="MiPerfil" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="CambiarPassword" method="post" @@submit.prevent="guardar">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card form-card">
                    <div class="card-header">
                        <i class="bi bi-shield-lock me-2"></i>Contrasena
                    </div>
                    <div class="card-body">

                        <div class="form-group mb-3">
                            <label class="form-label">Contrasena Actual</label>
                            <input name="passwordActual" type="password" class="form-control" v-model="passwordActual"
                                   required />
                            <span class="text-danger small" v-if="errores.passwordActual">{{ errores.passwordActual
                                }}</span>
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label">Nueva Contrasena</label>
                                <input name="passwordNueva" type="password" class="form-control" v-model="passwordNueva"
                                       required />
                                <span class="text-danger small" v-if="errores.passwordNueva">{{ errores.passwordNueva
                                    }}</span>

                                    <div class="progress mt-2" style="height: 8px;" v-if="passwordNueva">
                                        <div class="progress-bar" :class="colorFortaleza"
                                             :style="{ width: porcentajeFortaleza + '%' }"></div>
                                    </div>
                                    <small class="text-muted" v-if="passwordNueva">
                                        Fortaleza: <strong>{{ textoFortaleza }}</strong>
                                    </small>
                                </div>

                                <div class="form-group mb-0">
                                    <label class="form-label">Confirmar Nueva Contrasena</label>
                                    <input name="confirmarPassword" type="password" class="form-control"
                                           v-model="confirmarPassword" required />
                                    <span class="text-danger small" v-if="errores.confirmarPassword">{{
                                        errores.confirmarPassword }}</span>
                                        <small class="text-success d-block mt-1"
                                               v-if="confirmarPassword && passwordNueva === confirmarPassword">
                                            <i class="bi bi-check-circle me-1"></i>Las contrasenas coinciden
                                        </small>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card form-card">
                                <div class="card-header">
                                    <i class="bi bi-info-circle me-2"></i>Recomendaciones
                                </div>
                                <div class="card-body">
                                    <p class="help-text">
                                        Para una contrasena segura, te recomendamos:
                                    </p>
                                    <ul class="help-list">
                                        <li>Usar al menos 8 caracteres.</li>
                                        <li>Combinar mayusculas y minusculas.</li>
                                        <li>Incluir numeros y simbolos.</li>
                                        <li>No usar datos personales.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" :disabled="guardando">
                            <i class="bi bi-check-circle me-1"></i>
                            {{ guardando ? 'Cambiando...' : 'Cambiar Contrasena' }}
                        </button>
                        <a asp-action="MiPerfil" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                    </div>

                </form>

            </div>

            @section Styles {
                <style>
                    .page-header {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        flex-wrap: wrap;
                        gap: 12px;
                        margin-bottom: 24px;
                    }

                    .page-title {
                        font-size: 1.75rem;
                        font-weight: 700;
                        color: #212529;
                        margin: 0 0 4px 0;
                    }

                    .page-subtitle {
                        color: #868e96;
                        font-size: 0.9rem;
                        margin: 0;
                    }

                    .form-card {
                        background-color: #ffffff;
                        border: 1px solid #e9ecef;
                        border-radius: 12px;
                        overflow: hidden;
                    }

                    .form-card .card-header {
                        background-color: #f8f9fa;
                        border-bottom: 1px solid #e9ecef;
                        padding: 14px 20px;
                        font-weight: 600;
                        font-size: 0.9rem;
                        color: #495057;
                    }

                    .form-card .card-body {
                        padding: 24px;
                    }

                    .form-label {
                        font-size: 0.85rem;
                        font-weight: 600;
                        color: #495057;
                        margin-bottom: 6px;
                    }

                    .form-control {
                        border-radius: 8px;
                        border: 1px solid #dee2e6;
                        padding: 10px 14px;
                        font-size: 0.9rem;
                        transition: all 0.15s ease;
                    }

                    .form-control:focus {
                        border-color: #0d6efd;
                        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
                    }

                    .form-actions {
                        display: flex;
                        gap: 8px;
                        margin-top: 24px;
                        padding-top: 20px;
                        border-top: 1px solid #e9ecef;
                    }

                    .help-text {
                        font-size: 0.85rem;
                        color: #495057;
                        margin-bottom: 12px;
                    }

                    .help-list {
                        font-size: 0.82rem;
                        color: #868e96;
                        padding-left: 18px;
                        margin: 0;
                    }

                    .help-list li {
                        margin-bottom: 6px;
                    }
                </style>
            }

            @section Scripts {
                @{
                    await Html.RenderPartialAsync("_ValidationScriptsPartial");
                }

                <script>
                    const { createApp } = Vue;

                    createApp({
                        data() {
                            return {
                                passwordActual: '',
                                passwordNueva: '',
                                confirmarPassword: '',
                                errores: {},
                                guardando: false
                            }
                        },
                        computed: {
                            porcentajeFortaleza() {
                                return this.calcularFortaleza(this.passwordNueva).porcentaje;
                            },
                            textoFortaleza() {
                                return this.calcularFortaleza(this.passwordNueva).texto;
                            },
                            colorFortaleza() {
                                return this.calcularFortaleza(this.passwordNueva).color;
                            }
                        },
                        methods: {
                            calcularFortaleza(pwd) {
                                if (!pwd) return { porcentaje: 0, texto: '', color: '' };
                                let puntos = 0;
                                if (pwd.length >= 6) puntos++;
                                if (pwd.length >= 10) puntos++;
                                if (/[A-Z]/.test(pwd)) puntos++;
                                if (/[0-9]/.test(pwd)) puntos++;
                                if (/[^A-Za-z0-9]/.test(pwd)) puntos++;

                                if (puntos <= 1) return { porcentaje: 20, texto: 'Muy debil', color: 'bg-danger' };
                                if (puntos === 2) return { porcentaje: 40, texto: 'Debil', color: 'bg-danger' };
                                if (puntos === 3) return { porcentaje: 60, texto: 'Media', color: 'bg-warning' };
                                if (puntos === 4) return { porcentaje: 80, texto: 'Fuerte', color: 'bg-info' };
                                return { porcentaje: 100, texto: 'Muy fuerte', color: 'bg-success' };
                            },
                            validar() {
                                this.errores = {};
                                if (!this.passwordActual) {
                                    this.errores.passwordActual = "La contrasena actual es obligatoria.";
                                }
                                if (!this.passwordNueva) {
                                    this.errores.passwordNueva = "La nueva contrasena es obligatoria.";
                                } else if (this.passwordNueva.length < 6) {
                                    this.errores.passwordNueva = "La contrasena debe tener al menos 6 caracteres.";
                                }
                                if (!this.confirmarPassword) {
                                    this.errores.confirmarPassword = "Debe confirmar la nueva contrasena.";
                                } else if (this.passwordNueva !== this.confirmarPassword) {
                                    this.errores.confirmarPassword = "Las contrasenas no coinciden.";
                                }
                                return Object.keys(this.errores).length === 0;
                            },
                            async guardar() {
                                if (!this.validar()) return;
                                this.guardando = true;
                                try {
                                    const form = document.querySelector('form');
                                    const formData = new FormData(form);
                                    formData.set('passwordActual', this.passwordActual);
                                    formData.set('passwordNueva', this.passwordNueva);
                                    formData.set('confirmarPassword', this.confirmarPassword);

                                    const response = await fetch(form.action, {
                                        method: 'POST',
                                        body: formData
                                    });

                                    if (response.redirected) {
                                        window.location.href = response.url;
                                    } else {
                                        const html = await response.text();
                                        document.documentElement.innerHTML = html;
                                    }
                                } catch (error) {
                                    alert('Error de conexion: ' + error.message);
                                } finally {
                                    this.guardando = false;
                                }
                            }
                        }
                    }).mount('#app-cambiar-password');
                </script>
            }