@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<h1>Cambiar Contraseña</h1>

<hr />
<div class="row" id="app-cambiar-password">
    <div class="col-md-6">
        <form asp-action="CambiarPassword" method="post" @@submit.prevent="guardar">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label class="control-label">Contraseña Actual</label>
                <input name="passwordActual" type="password" class="form-control"
                       v-model="passwordActual" required />
                <span class="text-danger" v-if="errores.passwordActual">{{ errores.passwordActual }}</span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Nueva Contraseña</label>
                <input name="passwordNueva" type="password" class="form-control"
                       v-model="passwordNueva" required />
                <span class="text-danger" v-if="errores.passwordNueva">{{ errores.passwordNueva }}</span>

                <div class="progress mt-2" style="height: 8px;" v-if="passwordNueva">
                    <div class="progress-bar" :class="colorFortaleza"
                         :style="{ width: porcentajeFortaleza + '%' }"></div>
                </div>
                <small class="text-muted" v-if="passwordNueva">
                    Fortaleza: <strong>{{ textoFortaleza }}</strong>
                </small>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Confirmar Nueva Contraseña</label>
                <input name="confirmarPassword" type="password" class="form-control"
                       v-model="confirmarPassword" required />
                <span class="text-danger" v-if="errores.confirmarPassword">{{ errores.confirmarPassword }}</span>
                <small class="text-success" v-if="confirmarPassword && passwordNueva === confirmarPassword">
                    <i class="bi bi-check-circle me-1"></i>Las contraseñas coinciden
                </small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary" :disabled="guardando">
                    <i class="bi bi-check-circle me-1"></i>
                    {{ guardando ? 'Cambiando...' : 'Cambiar Contraseña' }}
                </button>
                <a asp-action="MiPerfil" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    passwordActual: '',
                    passwordNueva: '',
                    confirmarPassword: '',
                    errores: {},
                    guardando: false
                }
            },
            computed: {
                porcentajeFortaleza() {
                    return this.calcularFortaleza(this.passwordNueva).porcentaje;
                },
                textoFortaleza() {
                    return this.calcularFortaleza(this.passwordNueva).texto;
                },
                colorFortaleza() {
                    return this.calcularFortaleza(this.passwordNueva).color;
                }
            },
            methods: {
                calcularFortaleza(pwd) {
                    if (!pwd) return { porcentaje: 0, texto: '', color: '' };
                    let puntos = 0;
                    if (pwd.length >= 6) puntos++;
                    if (pwd.length >= 10) puntos++;
                    if (/[A-Z]/.test(pwd)) puntos++;
                    if (/[0-9]/.test(pwd)) puntos++;
                    if (/[^A-Za-z0-9]/.test(pwd)) puntos++;

                    if (puntos <= 1) return { porcentaje: 20, texto: 'Muy débil', color: 'bg-danger' };
                    if (puntos === 2) return { porcentaje: 40, texto: 'Débil', color: 'bg-danger' };
                    if (puntos === 3) return { porcentaje: 60, texto: 'Media', color: 'bg-warning' };
                    if (puntos === 4) return { porcentaje: 80, texto: 'Fuerte', color: 'bg-info' };
                    return { porcentaje: 100, texto: 'Muy fuerte', color: 'bg-success' };
                },
                validar() {
                    this.errores = {};
                    if (!this.passwordActual) {
                        this.errores.passwordActual = "La contraseña actual es obligatoria.";
                    }
                    if (!this.passwordNueva) {
                        this.errores.passwordNueva = "La nueva contraseña es obligatoria.";
                    } else if (this.passwordNueva.length < 6) {
                        this.errores.passwordNueva = "La contraseña debe tener al menos 6 caracteres.";
                    }
                    if (!this.confirmarPassword) {
                        this.errores.confirmarPassword = "Debe confirmar la nueva contraseña.";
                    } else if (this.passwordNueva !== this.confirmarPassword) {
                        this.errores.confirmarPassword = "Las contraseñas no coinciden.";
                    }
                    return Object.keys(this.errores).length === 0;
                },
                async guardar() {
                    if (!this.validar()) return;
                    this.guardando = true;
                    try {
                        const form = document.querySelector('form');
                        const formData = new FormData(form);
                        formData.set('passwordActual', this.passwordActual);
                        formData.set('passwordNueva', this.passwordNueva);
                        formData.set('confirmarPassword', this.confirmarPassword);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            const html = await response.text();
                            document.open();
                            document.write(html);
                            document.close();
                        }
                    } catch (error) {
                        alert('Error de conexión: ' + error.message);
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#app-cambiar-password');
    </script>
}