@model InmobiliariaTPI.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<h1>Editar Usuario</h1>

<hr />
<div class="row" id="app-usuario">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" @@submit.prevent="guardar">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaCreacion" />
            <input type="hidden" name="Password" :value="usuario.password" />

            <div class="form-group mb-3">
                <label asp-for="NombreCompleto" class="control-label">Nombre Completo</label>
                <input asp-for="NombreCompleto" class="form-control" v-model="usuario.nombreCompleto" />
                <span class="text-danger" v-if="errores.nombreCompleto">{{ errores.nombreCompleto }}</span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" v-model="usuario.email" />
                <span class="text-danger" v-if="errores.email">{{ errores.email }}</span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Rol" class="control-label">Rol</label>
                <select asp-for="Rol" class="form-control" v-model="usuario.rol">
                    <option value="">-- Seleccione un rol --</option>
                    <option value="Administrador">Administrador</option>
                    <option value="Empleado">Empleado</option>
                </select>
                <span class="text-danger" v-if="errores.rol">{{ errores.rol }}</span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Avatar" class="control-label">Avatar (URL)</label>
                <input asp-for="Avatar" class="form-control" v-model="usuario.avatar" />
            </div>

            <hr />
            <h5>Cambiar Contraseña (opcional)</h5>

            <div class="form-group mb-3">
                <label class="control-label">Nueva Contraseña</label>
                <input class="form-control" type="password" v-model="nuevaPassword" />
                <span class="text-danger" v-if="errores.nuevaPassword">{{ errores.nuevaPassword }}</span>

                <div class="progress mt-2" style="height: 8px;" v-if="nuevaPassword">
                    <div class="progress-bar" :class="colorFortaleza" :style="{ width: porcentajeFortaleza + '%' }">
                    </div>
                </div>
                <small class="text-muted" v-if="nuevaPassword">
                    Fortaleza: <strong>{{ textoFortaleza }}</strong>
                </small>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Confirmar Nueva Contraseña</label>
                <input class="form-control" type="password" v-model="confirmarPassword" />
                <span class="text-danger" v-if="errores.confirmarPassword">{{ errores.confirmarPassword }}</span>
                <small class="text-success" v-if="confirmarPassword && nuevaPassword === confirmarPassword">
                    <i class="bi bi-check-circle me-1"></i>Las contraseñas coinciden
                </small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary" :disabled="guardando">
                    <i class="bi bi-check-circle me-1"></i>
                    {{ guardando ? 'Guardando...' : 'Guardar' }}
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    usuario: {
                        id: @(Model?.Id ?? 0),
                        nombreCompleto: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.NombreCompleto ?? "")),
                        email: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Email ?? "")),
                        rol: '@(Model?.Rol.ToString() ?? "")',
                        avatar: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Avatar ?? "")),
                        password: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Password ?? ""))
                        },
                    nuevaPassword: '',
                    confirmarPassword: '',
                    errores: {},
                    guardando: false
                }
            },
            computed: {
                porcentajeFortaleza() {
                    return this.calcularFortaleza(this.nuevaPassword).porcentaje;
                },
                textoFortaleza() {
                    return this.calcularFortaleza(this.nuevaPassword).texto;
                },
                colorFortaleza() {
                    return this.calcularFortaleza(this.nuevaPassword).color;
                }
            },
            methods: {
                calcularFortaleza(pwd) {
                    if (!pwd) return { porcentaje: 0, texto: '', color: '' };
                    let puntos = 0;
                    if (pwd.length >= 6) puntos++;
                    if (pwd.length >= 10) puntos++;
                    if (/[A-Z]/.test(pwd)) puntos++;
                    if (/[0-9]/.test(pwd)) puntos++;
                    if (/[^A-Za-z0-9]/.test(pwd)) puntos++;

                    if (puntos <= 1) return { porcentaje: 20, texto: 'Muy débil', color: 'bg-danger' };
                    if (puntos === 2) return { porcentaje: 40, texto: 'Débil', color: 'bg-danger' };
                    if (puntos === 3) return { porcentaje: 60, texto: 'Media', color: 'bg-warning' };
                    if (puntos === 4) return { porcentaje: 80, texto: 'Fuerte', color: 'bg-info' };
                    return { porcentaje: 100, texto: 'Muy fuerte', color: 'bg-success' };
                },
                validar() {
                    this.errores = {};
                    if (!this.usuario.nombreCompleto) {
                        this.errores.nombreCompleto = "El nombre completo es obligatorio.";
                    }
                    if (!this.usuario.email) {
                        this.errores.email = "El email es obligatorio.";
                    } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(this.usuario.email)) {
                        this.errores.email = "El email no tiene un formato válido.";
                    }
                    if (!this.usuario.rol) {
                        this.errores.rol = "Debe seleccionar un rol.";
                    }
                    if (this.nuevaPassword) {
                        if (this.nuevaPassword.length < 6) {
                            this.errores.nuevaPassword = "La contraseña debe tener al menos 6 caracteres.";
                        }
                        if (this.nuevaPassword !== this.confirmarPassword) {
                            this.errores.confirmarPassword = "Las contraseñas no coinciden.";
                        }
                    }
                    return Object.keys(this.errores).length === 0;
                },
                async guardar() {
                    if (!this.validar()) return;
                    this.guardando = true;
                    try {
                        if (this.nuevaPassword) {
                            this.usuario.password = this.nuevaPassword;
                        }

                        const form = document.querySelector('form');
                        const formData = new FormData(form);
                        formData.set('Id', this.usuario.id);
                        formData.set('NombreCompleto', this.usuario.nombreCompleto);
                        formData.set('Email', this.usuario.email);
                        formData.set('Rol', this.usuario.rol);
                        formData.set('Avatar', this.usuario.avatar);
                        formData.set('Password', this.usuario.password);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            const html = await response.text();
                            document.documentElement.innerHTML = html;
                        }
                    } catch (error) {
                        alert('Error de conexión: ' + error.message);
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#app-usuario');
    </script>
}