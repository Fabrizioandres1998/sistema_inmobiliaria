@model IPagedList<InmobiliariaTPI.Models.Inquilino>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Inquilinos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="app-inquilinos">
    <h1>Inquilinos</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary" title="Crear Nuevo Inquilino">
            <i class="bi bi-plus-circle"></i> Crear Nuevo Inquilino
        </a>
    </p>

    <div class="input-group mb-3">
        <input type="text" class="form-control" placeholder="Buscar por nombre, DNI o email..." v-model="busqueda" />
        <button type="button" class="btn btn-outline-secondary" v-if="busqueda" @@click="busqueda = ''">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Id)</th>
                <th>@Html.DisplayNameFor(model => model.First().NombreCompleto)</th>
                <th>@Html.DisplayNameFor(model => model.First().Dni)</th>
                <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                <th>@Html.DisplayNameFor(model => model.First().Telefono)</th>
                <th class="text-nowrap">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr v-if="coincide('@item.NombreCompleto', '@item.Dni', '@item.Email')">
                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                    <td>@Html.DisplayFor(modelItem => item.NombreCompleto)</td>
                    <td>@Html.DisplayFor(modelItem => item.Dni)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Ver detalles">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm }),
            new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    busqueda: ''
                }
            },
            methods: {
                coincide(nombre, dni, email) {
                    if (!this.busqueda) return true;
                    const term = this.busqueda.toLowerCase().trim();
                    return (nombre && nombre.toLowerCase().includes(term)) ||
                        (dni && dni.toLowerCase().includes(term)) ||
                        (email && email.toLowerCase().includes(term));
                }
            }
        }).mount('#app-inquilinos');
    </script>
}