@model InmobiliariaTPI.Models.Reserva

@{
    ViewData["Title"] = "Detalles de la Reserva";
    var pagos = ViewBag.Pagos as IEnumerable<InmobiliariaTPI.Models.Pago>;
    decimal totalPagado = ViewBag.TotalPagado ?? 0m;
    decimal saldoPendiente = ViewBag.SaldoPendiente ?? 0m;
}

<h1>Detalles de la Reserva</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="app-pagos">
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Id)</dd>

            <dt class="col-sm-3">Inmueble</dt>
            <dd class="col-sm-9">@Model.Inmueble?.Direccion</dd>

            <dt class="col-sm-3">Inquilino</dt>
            <dd class="col-sm-9">@Model.Inquilino?.NombreCompleto</dd>

            <dt class="col-sm-3">Fecha Inicio</dt>
            <dd class="col-sm-9">@Model.FechaInicio.ToShortDateString()</dd>

            <dt class="col-sm-3">Fecha Fin</dt>
            <dd class="col-sm-9">@Model.FechaFin.ToShortDateString()</dd>

            @if (Model.FechaFinOriginal.HasValue)
            {
                <dt class="col-sm-3">Fecha Fin Original</dt>
                <dd class="col-sm-9">@Model.FechaFinOriginal.Value.ToShortDateString()</dd>
            }

            <dt class="col-sm-3">Monto por Día</dt>
            <dd class="col-sm-9">@Model.MontoPorDia.ToString("N2")</dd>

            <dt class="col-sm-3">Monto Total</dt>
            <dd class="col-sm-9">@Model.MontoTotal.ToString("N2")</dd>

            <dt class="col-sm-3">Total Pagado</dt>
            <dd class="col-sm-9">@totalPagado.ToString("N2")</dd>

            <dt class="col-sm-3">Saldo Pendiente</dt>
            <dd class="col-sm-9">
                <strong class="@(saldoPendiente > 0 ? "text-danger" : "text-success")">
                    @saldoPendiente.ToString("N2")
                </strong>
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Estado.Equals("Activa", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="badge bg-success">Activa</span>
                }
                else if (Model.Estado.Equals("Finalizada", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="badge bg-secondary">Finalizada</span>
                }
                else
                {
                    <span class="badge bg-danger">Cancelada</span>
                }
            </dd>

            <dt class="col-sm-3">Fecha Creación</dt>
            <dd class="col-sm-9">@Model.FechaCreacion.ToShortDateString()</dd>

            @if (Model.FechaTerminacion.HasValue)
            {
                <dt class="col-sm-3">Fecha Terminación</dt>
                <dd class="col-sm-9">@Model.FechaTerminacion.Value.ToShortDateString()</dd>
            }

            @if (Model.MultaAplicada.HasValue)
            {
                <dt class="col-sm-3">Multa Aplicada</dt>
                <dd class="col-sm-9">@Model.MultaAplicada.Value.ToString("N2")</dd>
            }

            @if (User.IsInRole("Administrador"))
            {
                <dt class="col-sm-3 border-top pt-3">Usuario Creador</dt>
                <dd class="col-sm-9 border-top pt-3">
                    @Model.UsuarioCreador?.NombreCompleto (ID: @Model.IdUsuarioCreador)
                </dd>

                @if (Model.IdUsuarioTerminacion.HasValue)
                {
                    <dt class="col-sm-3">Usuario Terminación</dt>
                    <dd class="col-sm-9">
                        @Model.UsuarioTerminacion?.NombreCompleto (ID: @Model.IdUsuarioTerminacion)
                    </dd>
                }
            }
        </dl>
    </div>

    <div class="mt-4">
        <h3>Pagos</h3>

        @if (Model.Estado.Equals("Activa", StringComparison.OrdinalIgnoreCase))
        {
            <p>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                        data-bs-target="#modalCrearPago" title="Agregar Pago">
                    <i class="bi bi-plus-circle"></i>
                </button>
            </p>
        }

        @if (pagos != null && pagos.Any())
        {
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Importe</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-nowrap">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in pagos)
                    {
                        <tr>
                            <td>@pago.Concepto</td>
                            <td>@pago.Importe.ToString("N2")</td>
                            <td>@pago.FechaPago.ToShortDateString()</td>
                            <td>
                                @if (pago.Estado == 1)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Anulado</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-controller="Pagos" asp-action="Details" asp-route-id="@pago.Id"
                                   class="btn btn-sm btn-info" title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (pago.Estado == 1)
                                {
                                    <a asp-controller="Pagos" asp-action="Edit" asp-route-id="@pago.Id"
                                       class="btn btn-sm btn-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-controller="Pagos" asp-action="Anular" asp-route-id="@pago.Id"
                                           class="btn btn-sm btn-danger" title="Anular">
                                            <i class="bi bi-x-circle"></i>
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                <p class="mb-0">No hay pagos registrados para esta reserva.</p>
            </div>
        }
    </div>

    <div class="modal fade" id="modalCrearPago" tabindex="-1" aria-labelledby="modalCrearPagoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalCrearPagoLabel">Agregar Pago</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Pagos" asp-action="Create" method="post" @@submit.prevent="guardar">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" name="IdReserva" value="@Model.Id" />
                        <input type="hidden" name="Importe" :value="importe" />

                        <div class="form-group mb-3">
                            <label class="control-label">Concepto</label>
                            <input name="Concepto" class="form-control" v-model="concepto" required />
                            <span class="text-danger" v-if="errores.concepto">{{ errores.concepto }}</span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label">Fecha de Pago</label>
                            <input name="FechaPago" class="form-control" type="date" v-model="fechaPago" required />
                            <span class="text-danger" v-if="errores.fechaPago">{{ errores.fechaPago }}</span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label">Importe</label>
                            <input class="form-control" type="number" step="0.01" v-model.number="importe" required />
                            <span class="text-danger" v-if="errores.importe">{{ errores.importe }}</span>
                            <small class="text-muted">Saldo pendiente: ${{ formatearPrecio(saldoPendiente) }}</small>
                        </div>

                        <div class="card" v-if="importe > 0">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-6"><i class="bi bi-cash me-2 text-success"></i>Importe:</div>
                                    <div class="col-6 text-end"><strong>${{ formatearPrecio(importe) }}</strong></div>
                                </div>
                                <div class="row">
                                    <div class="col-6"><i class="bi bi-wallet2 me-2 text-warning"></i>Saldo restante:</div>
                                    <div class="col-6 text-end">
                                        <strong :class="saldoRestante > 0 ? 'text-danger' : 'text-success'">
                                            ${{ formatearPrecio(saldoRestante) }}
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" :disabled="guardando">
                            {{ guardando ? 'Guardando...' : 'Guardar' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning" title="Editar">
            <i class="bi bi-pencil"></i>
        </a>
        @if (Model.Estado.Equals("Activa", StringComparison.OrdinalIgnoreCase))
        {
            <a asp-action="Finalizar" asp-route-id="@Model.Id" class="btn btn-danger" title="Finalizar">
                <i class="bi bi-flag"></i>
            </a>
            <a asp-action="Renovar" asp-route-id="@Model.Id" class="btn btn-success" title="Renovar">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary" title="Volver">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    concepto: '',
                    fechaPago: '@DateTime.Now.ToString("yyyy-MM-dd")',
                    importe: 0,
                    saldoPendiente: @saldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    errores: {},
                    guardando: false
                }
            },
            computed: {
                saldoRestante() {
                    return this.saldoPendiente - this.importe;
                }
            },
            methods: {
                formatearPrecio(valor) {
                    return new Intl.NumberFormat('es-AR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }).format(valor || 0);
                },
                validar() {
                    this.errores = {};
                    if (!this.concepto) {
                        this.errores.concepto = "El concepto es obligatorio.";
                    }
                    if (!this.fechaPago) {
                        this.errores.fechaPago = "La fecha de pago es obligatoria.";
                    }
                    if (!this.importe || this.importe <= 0) {
                        this.errores.importe = "El importe debe ser mayor a 0.";
                    }
                    if (this.importe > this.saldoPendiente) {
                        this.errores.importe = "El importe no puede superar el saldo pendiente.";
                    }
                    return Object.keys(this.errores).length === 0;
                },
                async guardar() {
                    if (!this.validar()) return;
                    this.guardando = true;
                    try {
                        const form = document.querySelector('#modalCrearPago form');
                        const formData = new FormData(form);
                        formData.set('Concepto', this.concepto);
                        formData.set('FechaPago', this.fechaPago);
                        formData.set('Importe', this.importe);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            const html = await response.text();
                            document.open();
                            document.write(html);
                            document.close();
                        }
                    } catch (error) {
                        alert('Error de conexión: ' + error.message);
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#app-pagos');
    </script>
}