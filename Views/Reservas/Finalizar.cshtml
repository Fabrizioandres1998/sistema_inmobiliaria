@model InmobiliariaTPI.ViewModels.FinalizarReservaViewModel

@{
    ViewData["Title"] = "Finalizar Reserva";
}

<h1>Finalizar Reserva</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="alert alert-warning">
    <h4>¿Estás seguro de finalizar esta reserva?</h4>
    <p>Se calculará la multa correspondiente según el tiempo transcurrido.</p>
</div>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Finalizar" asp-route-id="@Model.Id" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FechaTerminacion" class="control-label"></label>
                <input asp-for="FechaTerminacion" class="form-control" type="date" />
                <span asp-validation-for="FechaTerminacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MultaCalculada" class="control-label"></label>
                @* La multa se informa al usuario, pero no se envía: al usar coma
                   decimal, la validación de jQuery impedía el submit del formulario. *@
                <input class="form-control" value="@Model.MultaCalculada.ToString("N2")" readonly />
                <span class="text-muted">La multa se calcula automáticamente</span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-danger">Finalizar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
