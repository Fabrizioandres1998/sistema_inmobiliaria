@model InmobiliariaTPI.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
}

<h1>Editar Reserva</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<hr />
<div class="row" id="app-reserva">
    <div class="col-md-8">
        <form asp-action="Edit" method="post" @@submit.prevent="guardar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IdUsuarioCreador" />
            <input type="hidden" asp-for="FechaCreacion" />

            <!-- Inmueble -->
            <div class="form-group mb-3 position-relative">
                <label class="control-label">Inmueble</label>
                <input type="text" class="form-control" placeholder="Buscar por dirección..." v-model="busquedaInmueble"
                @@focus="mostrarSugerencias = true" @@blur="cerrarSugerencias" autocomplete="off" />
                <input type="hidden" name="IdInmueble" :value="reserva.idInmueble" />

                <ul class="list-group position-absolute w-100 shadow"
                    style="z-index: 1000; max-height: 300px; overflow-y: auto;"
                    v-if="mostrarSugerencias && inmueblesFiltrados.length > 0">
                    <li class="list-group-item list-group-item-action" v-for="inm in inmueblesFiltrados" :key="inm.id"
                        @@mousedown.prevent="seleccionarInmueble(inm)" style="cursor: pointer;">
                        <div class="d-flex justify-content-between">
                            <span>{{ inm.direccion }}</span>
                            <span class="text-muted">${{ formatearPrecio(inm.precio) }}/día</span>
                        </div>
                    </li>
                </ul>

                <div class="text-muted mt-1"
                     v-if="mostrarSugerencias && busquedaInmueble && inmueblesFiltrados.length === 0">
                    No se encontraron inmuebles con esa dirección.
                </div>

                <div class="mt-2" v-if="inmuebleSeleccionado">
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Seleccionado: {{ inmuebleSeleccionado.direccion }}
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" @@click="limpiarInmueble">
                        <i class="bi bi-x-circle me-1"></i>Quitar
                    </button>
                </div>

                <span class="text-danger" v-if="errores.idInmueble">{{ errores.idInmueble }}</span>
            </div>

            <!-- Inquilino -->
            <div class="form-group mb-3 position-relative">
                <label class="control-label">Inquilino</label>
                <input type="text" class="form-control" placeholder="Buscar por nombre o DNI..."
                       v-model="busquedaInquilino" @@focus="mostrarSugerenciasInquilino = true"
                @@blur="cerrarSugerenciasInquilino" autocomplete="off" />
                <input type="hidden" name="IdInquilino" :value="reserva.idInquilino" />

                <ul class="list-group position-absolute w-100 shadow"
                    style="z-index: 1000; max-height: 300px; overflow-y: auto;"
                    v-if="mostrarSugerenciasInquilino && inquilinosFiltrados.length > 0">
                    <li class="list-group-item list-group-item-action" v-for="inq in inquilinosFiltrados" :key="inq.id"
                        @@mousedown.prevent="seleccionarInquilino(inq)" style="cursor: pointer;">
                        <div class="d-flex justify-content-between">
                            <span>{{ inq.nombreCompleto }}</span>
                            <span class="text-muted">DNI: {{ inq.dni }}</span>
                        </div>
                    </li>
                </ul>

                <div class="text-muted mt-1"
                     v-if="mostrarSugerenciasInquilino && busquedaInquilino && inquilinosFiltrados.length === 0">
                    No se encontraron inquilinos con ese criterio.
                </div>

                <div class="mt-2" v-if="inquilinoSeleccionado">
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Seleccionado: {{ inquilinoSeleccionado.nombreCompleto }}
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" @@click="limpiarInquilino">
                        <i class="bi bi-x-circle me-1"></i>Quitar
                    </button>
                </div>

                <span class="text-danger" v-if="errores.idInquilino">{{ errores.idInquilino }}</span>
            </div>

            <!-- Fechas -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FechaInicio" class="control-label"></label>
                        <input asp-for="FechaInicio" class="form-control" type="date" v-model="reserva.fechaInicio" />
                        <span class="text-danger" v-if="errores.fechaInicio">{{ errores.fechaInicio }}</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FechaFin" class="control-label"></label>
                        <input asp-for="FechaFin" class="form-control" type="date" v-model="reserva.fechaFin" />
                        <span class="text-danger" v-if="errores.fechaFin">{{ errores.fechaFin }}</span>
                    </div>
                </div>
            </div>

            <!-- Monto por día -->
            <div class="form-group mb-3">
                <label asp-for="MontoPorDia" class="control-label">Precio por Día</label>
                <input asp-for="MontoPorDia" class="form-control" :value="reserva.montoPorDia" readonly />
            </div>

            <!-- Estado (solo visible para admin, opcional) -->
            <div class="form-group mb-3">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control" v-model="reserva.estado">
                    <option value="Activa">Activa</option>
                    <option value="Finalizada">Finalizada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>

            <!-- Resumen -->
            <div class="card mb-3" v-if="reserva.idInmueble && reserva.montoPorDia > 0 && dias > 0">
                <div class="card-header bg-light">
                    <strong><i class="bi bi-clipboard-check me-2"></i>Resumen de la Reserva</strong>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-6">
                            <i class="bi bi-calendar-event me-2 text-primary"></i>Días totales:
                        </div>
                        <div class="col-6 text-end"><strong>{{ dias }}</strong></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <i class="bi bi-currency-dollar me-2 text-success"></i>Precio por día:
                        </div>
                        <div class="col-6 text-end"><strong>${{ formatearPrecio(reserva.montoPorDia) }}</strong></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <i class="bi bi-cash me-2 text-success"></i>Subtotal:
                        </div>
                        <div class="col-6 text-end"><strong>${{ formatearPrecio(subtotal) }}</strong></div>
                    </div>
                    <div class="row mb-2" v-if="porcentajeReserva > 0">
                        <div class="col-6">
                            <i class="bi bi-percent me-2 text-warning"></i>Seña ({{ porcentajeReserva }}%):
                        </div>
                        <div class="col-6 text-end"><strong>${{ formatearPrecio(sena) }}</strong></div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <strong><i class="bi bi-credit-card me-2 text-success"></i>Total a pagar:</strong>
                        </div>
                        <div class="col-6 text-end">
                            <strong class="text-success">${{ formatearPrecio(total) }}</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary" :disabled="guardando">
                    <i class="bi bi-check-circle me-1"></i>
                    {{ guardando ? 'Guardando...' : 'Guardar' }}
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    // Inmuebles
                    inmuebles: @Html.Raw(ViewBag.InmueblesJson ?? "[]"),
                    busquedaInmueble: '',
                    mostrarSugerencias: false,
                    inmuebleSeleccionado: @Html.Raw(ViewBag.InmuebleActualJson ?? "null"),

                    // Inquilinos
                    inquilinos: @Html.Raw(ViewBag.InquilinosJson ?? "[]"),
                    busquedaInquilino: '',
                    mostrarSugerenciasInquilino: false,
                    inquilinoSeleccionado: @Html.Raw(ViewBag.InquilinoActualJson ?? "null"),

                    // Reserva
                    reserva: {
                        idInmueble: @(Model?.IdInmueble ?? 0),
                        idInquilino: @(Model?.IdInquilino ?? 0),
                        fechaInicio: '@(Model?.FechaInicio.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))',
                        fechaFin: '@(Model?.FechaFin.ToString("yyyy-MM-dd") ?? DateTime.Now.AddDays(7).ToString("yyyy-MM-dd"))',
                        montoPorDia: @(Model?.MontoPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                        estado: '@(Model?.Estado ?? "Activa")'
                    },
                    porcentajeReserva: 0,
                    errores: {},
                    guardando: false
                }
            },
            computed: {
                inmueblesFiltrados() {
                    if (!this.busquedaInmueble) return this.inmuebles.slice(0, 30);
                    const term = this.busquedaInmueble.toLowerCase().trim();
                    return this.inmuebles
                        .filter(i => i.direccion.toLowerCase().includes(term))
                        .slice(0, 30);
                },
                inquilinosFiltrados() {
                    if (!this.busquedaInquilino) return this.inquilinos.slice(0, 30);
                    const term = this.busquedaInquilino.toLowerCase().trim();
                    return this.inquilinos
                        .filter(i =>
                            i.nombreCompleto.toLowerCase().includes(term) ||
                            (i.dni && i.dni.includes(term))
                        )
                        .slice(0, 30);
                },
                dias() {
                    if (!this.reserva.fechaInicio || !this.reserva.fechaFin) return 0;
                    const inicio = new Date(this.reserva.fechaInicio);
                    const fin = new Date(this.reserva.fechaFin);
                    const diff = Math.ceil((fin - inicio) / (1000 * 60 * 60 * 24));
                    return diff > 0 ? diff : 0;
                },
                subtotal() {
                    return this.dias * this.reserva.montoPorDia;
                },
                sena() {
                    return this.subtotal * (this.porcentajeReserva / 100);
                },
                total() {
                    return this.sena > 0 ? this.sena : this.subtotal;
                }
            },
            mounted() {
                // Pre-seleccionar inmueble e inquilino actuales
                if (this.inmuebleSeleccionado) {
                    this.busquedaInmueble = this.inmuebleSeleccionado.direccion;
                    this.porcentajeReserva = this.inmuebleSeleccionado.porcentaje || 0;
                }
                if (this.inquilinoSeleccionado) {
                    this.busquedaInquilino = this.inquilinoSeleccionado.nombreCompleto;
                }
            },
            methods: {
                formatearPrecio(valor) {
                    return new Intl.NumberFormat('es-AR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }).format(valor || 0);
                },
                seleccionarInmueble(inm) {
                    this.inmuebleSeleccionado = inm;
                    this.reserva.idInmueble = inm.id;
                    this.reserva.montoPorDia = inm.precio;
                    this.porcentajeReserva = inm.porcentaje || 0;
                    this.busquedaInmueble = inm.direccion;
                    this.mostrarSugerencias = false;
                },
                limpiarInmueble() {
                    this.inmuebleSeleccionado = null;
                    this.reserva.idInmueble = 0;
                    this.reserva.montoPorDia = 0;
                    this.porcentajeReserva = 0;
                    this.busquedaInmueble = '';
                },
                cerrarSugerencias() {
                    setTimeout(() => { this.mostrarSugerencias = false; }, 150);
                },
                seleccionarInquilino(inq) {
                    this.inquilinoSeleccionado = inq;
                    this.reserva.idInquilino = inq.id;
                    this.busquedaInquilino = inq.nombreCompleto;
                    this.mostrarSugerenciasInquilino = false;
                },
                limpiarInquilino() {
                    this.inquilinoSeleccionado = null;
                    this.reserva.idInquilino = 0;
                    this.busquedaInquilino = '';
                },
                cerrarSugerenciasInquilino() {
                    setTimeout(() => { this.mostrarSugerenciasInquilino = false; }, 150);
                },
                validar() {
                    this.errores = {};
                    if (!this.reserva.idInmueble) {
                        this.errores.idInmueble = "Debe seleccionar un inmueble.";
                    }
                    if (!this.reserva.idInquilino) {
                        this.errores.idInquilino = "Debe seleccionar un inquilino.";
                    }
                    if (!this.reserva.fechaInicio) {
                        this.errores.fechaInicio = "La fecha de inicio es obligatoria.";
                    }
                    if (!this.reserva.fechaFin) {
                        this.errores.fechaFin = "La fecha de fin es obligatoria.";
                    }
                    if (this.dias <= 0) {
                        this.errores.fechaFin = "La fecha de fin debe ser posterior a la de inicio.";
                    }
                    return Object.keys(this.errores).length === 0;
                },
                async guardar() {
                    if (!this.validar()) return;
                    this.guardando = true;
                    try {
                        const form = document.querySelector('form');
                        const formData = new FormData(form);
                        formData.set('Id', @(Model?.Id ?? 0));
                        formData.set('IdInmueble', this.reserva.idInmueble);
                        formData.set('IdInquilino', this.reserva.idInquilino);
                        formData.set('FechaInicio', this.reserva.fechaInicio);
                        formData.set('FechaFin', this.reserva.fechaFin);
                        formData.set('MontoPorDia', this.reserva.montoPorDia);
                        formData.set('Estado', this.reserva.estado);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            const html = await response.text();
                            document.open();
                            document.write(html);
                            document.close();
                        }
                    } catch (error) {
                        alert('Error de conexión: ' + error.message);
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#app-reserva');
    </script>
}