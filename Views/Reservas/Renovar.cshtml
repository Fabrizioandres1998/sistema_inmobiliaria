@model InmobiliariaTPI.Models.Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<div id="app-renovar">

    <div class="page-header">
        <div>
            <h1 class="page-title">Renovar Reserva</h1>
            <p class="page-subtitle">Extiende la reserva con nuevas fechas</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="Renovar" method="post" @@submit.prevent="guardar">
        <input type="hidden" asp-for="IdInmueble" />
        <input type="hidden" asp-for="IdInquilino" />
        <input type="hidden" asp-for="IdUsuarioCreador" v-model="idUsuarioCreador" />
        <input type="hidden" asp-for="MontoPorDia" :value="montoPorDia" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-4">
            <div class="col-lg-8">

                <div class="card form-card">
                    <div class="card-header">
                        <i class="bi bi-info-circle me-2"></i>Datos de la Reserva Original
                    </div>
                    <div class="card-body">
                        <dl class="detail-list">

                            <div class="detail-row">
                                <dt>Inmueble</dt>
                                <dd>@ViewBag.InmuebleNombre</dd>
                            </div>

                            <div class="detail-row">
                                <dt>Inquilino</dt>
                                <dd>@ViewBag.InquilinoNombre</dd>
                            </div>

                            <div class="detail-row">
                                <dt>Monto por dia</dt>
                                <dd class="text-success fw-semibold">$@Model.MontoPorDia.ToString("N2")</dd>
                            </div>

                        </dl>
                    </div>
                </div>

                <div class="card form-card mt-4">
                    <div class="card-header">
                        <i class="bi bi-calendar-plus me-2"></i>Nuevas Fechas
                    </div>
                    <div class="card-body">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaInicio" class="form-label"></label>
                                    <input asp-for="FechaInicio" class="form-control" type="date"
                                           v-model="fechaInicio" />
                                    <span class="text-danger small" v-if="errores.fechaInicio">{{ errores.fechaInicio
                                        }}</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="FechaFin" class="form-label"></label>
                                        <input asp-for="FechaFin" class="form-control" type="date" v-model="fechaFin" />
                                        <span class="text-danger small" v-if="errores.fechaFin">{{ errores.fechaFin
                                            }}</span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <div class="col-lg-4">
                        <div class="card form-card" v-if="dias > 0">
                            <div class="card-header">
                                <i class="bi bi-calculator me-2"></i>Resumen
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-6 text-muted">Dias totales:</div>
                                    <div class="col-6 text-end fw-semibold">{{ dias }}</div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6 text-muted">Precio por dia:</div>
                                    <div class="col-6 text-end fw-semibold">${{ formatearPrecio(montoPorDia) }}</div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-6 fw-semibold">Total a pagar:</div>
                                    <div class="col-6 text-end">
                                        <span class="text-success fw-bold fs-5">${{ formatearPrecio(total) }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-success" :disabled="guardando">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        {{ guardando ? 'Renovando...' : 'Renovar Reserva' }}
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </a>
                </div>

            </form>

        </div>

        @section Styles {
            <style>
                .page-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-bottom: 24px;
                }

                .page-title {
                    font-size: 1.75rem;
                    font-weight: 700;
                    color: #212529;
                    margin: 0 0 4px 0;
                }

                .page-subtitle {
                    color: #868e96;
                    font-size: 0.9rem;
                    margin: 0;
                }

                .form-card {
                    background-color: #ffffff;
                    border: 1px solid #e9ecef;
                    border-radius: 12px;
                    overflow: hidden;
                }

                .form-card .card-header {
                    background-color: #f8f9fa;
                    border-bottom: 1px solid #e9ecef;
                    padding: 14px 20px;
                    font-weight: 600;
                    font-size: 0.9rem;
                    color: #495057;
                }

                .form-card .card-body {
                    padding: 20px 24px;
                }

                .form-label {
                    font-size: 0.85rem;
                    font-weight: 600;
                    color: #495057;
                    margin-bottom: 6px;
                }

                .form-control {
                    border-radius: 8px;
                    border: 1px solid #dee2e6;
                    padding: 10px 14px;
                    font-size: 0.9rem;
                    transition: all 0.15s ease;
                }

                .form-control:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
                }

                .detail-list {
                    margin: 0;
                }

                .detail-row {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 16px;
                    padding: 12px 0;
                    border-bottom: 1px solid #f1f3f5;
                }

                .detail-row:last-child {
                    border-bottom: none;
                }

                .detail-row dt {
                    font-size: 0.85rem;
                    font-weight: 500;
                    color: #868e96;
                    margin: 0;
                    flex-shrink: 0;
                }

                .detail-row dd {
                    font-size: 0.9rem;
                    font-weight: 500;
                    color: #212529;
                    margin: 0;
                    text-align: right;
                    word-break: break-word;
                }

                .form-actions {
                    display: flex;
                    gap: 8px;
                    margin-top: 24px;
                    padding-top: 20px;
                    border-top: 1px solid #e9ecef;
                }
            </style>
        }

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }

            <script>
                const { createApp } = Vue;

                createApp({
                    data() {
                        return {
                            fechaInicio: '@(Model?.FechaInicio.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))',
                            fechaFin: '@(Model?.FechaFin.ToString("yyyy-MM-dd") ?? DateTime.Now.AddDays(7).ToString("yyyy-MM-dd"))',
                            montoPorDia: @(Model?.MontoPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                            idUsuarioCreador: @(Model?.IdUsuarioCreador ?? 0),
                            errores: {},
                            guardando: false
                        }
                    },
                    computed: {
                        dias() {
                            if (!this.fechaInicio || !this.fechaFin) return 0;
                            const inicio = new Date(this.fechaInicio);
                            const fin = new Date(this.fechaFin);
                            const diff = Math.ceil((fin - inicio) / (1000 * 60 * 60 * 24));
                            return diff > 0 ? diff : 0;
                        },
                        total() {
                            return this.dias * this.montoPorDia;
                        }
                    },
                    methods: {
                        formatearPrecio(valor) {
                            return new Intl.NumberFormat('es-AR', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }).format(valor || 0);
                        },
                        validar() {
                            this.errores = {};
                            if (!this.fechaInicio) {
                                this.errores.fechaInicio = "La fecha de inicio es obligatoria.";
                            }
                            if (!this.fechaFin) {
                                this.errores.fechaFin = "La fecha de fin es obligatoria.";
                            }
                            if (this.dias <= 0) {
                                this.errores.fechaFin = "La fecha de fin debe ser posterior a la de inicio.";
                            }
                            return Object.keys(this.errores).length === 0;
                        },
                        async guardar() {
                            if (!this.validar()) return;
                            this.guardando = true;
                            try {
                                const form = document.querySelector('form');
                                const formData = new FormData(form);
                                formData.set('FechaInicio', this.fechaInicio);
                                formData.set('FechaFin', this.fechaFin);
                                formData.set('MontoPorDia', this.montoPorDia);
                                formData.set('IdUsuarioCreador', this.idUsuarioCreador);

                                const response = await fetch(form.action, {
                                    method: 'POST',
                                    body: formData
                                });

                                if (response.redirected) {
                                    window.location.href = response.url;
                                } else {
                                    const html = await response.text();
                                    document.documentElement.innerHTML = html;
                                }
                            } catch (error) {
                                alert('Error de conexion: ' + error.message);
                            } finally {
                                this.guardando = false;
                            }
                        }
                    }
                }).mount('#app-renovar');
            </script>
        }