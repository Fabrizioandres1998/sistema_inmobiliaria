@model InmobiliariaTPI.Models.Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<h1>Renovar Reserva</h1>

<hr />
<div class="row" id="app-renovar">
    <div class="col-md-8">
        <form asp-action="Renovar" method="post" @@submit.prevent="guardar">
            <input type="hidden" asp-for="IdInmueble" />
            <input type="hidden" asp-for="IdInquilino" />
            <input type="hidden" asp-for="IdUsuarioCreador" v-model="idUsuarioCreador" />
            <input type="hidden" asp-for="MontoPorDia" :value="montoPorDia" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="card mb-3">
                <div class="card-header bg-light">
                    <strong><i class="bi bi-info-circle me-2"></i>Datos de la Reserva</strong>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-4 text-muted">Inmueble:</div>
                        <div class="col-8">@ViewBag.InmuebleNombre</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 text-muted">Inquilino:</div>
                        <div class="col-8">@ViewBag.InquilinoNombre</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 text-muted">Monto por Día:</div>
                        <div class="col-8">$@Model.MontoPorDia.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FechaInicio" class="control-label"></label>
                        <input asp-for="FechaInicio" class="form-control" type="date" v-model="fechaInicio" />
                        <span class="text-danger" v-if="errores.fechaInicio">{{ errores.fechaInicio }}</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FechaFin" class="control-label"></label>
                        <input asp-for="FechaFin" class="form-control" type="date" v-model="fechaFin" />
                        <span class="text-danger" v-if="errores.fechaFin">{{ errores.fechaFin }}</span>
                    </div>
                </div>
            </div>

            <div class="card mb-3" v-if="dias > 0">
                <div class="card-header bg-light">
                    <strong><i class="bi bi-calculator me-2"></i>Resumen de la Renovación</strong>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-6">
                            <i class="bi bi-calendar-event me-2 text-primary"></i>Días totales:
                        </div>
                        <div class="col-6 text-end"><strong>{{ dias }}</strong></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <i class="bi bi-currency-dollar me-2 text-success"></i>Precio por día:
                        </div>
                        <div class="col-6 text-end"><strong>${{ formatearPrecio(montoPorDia) }}</strong></div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <strong><i class="bi bi-credit-card me-2 text-success"></i>Total a pagar:</strong>
                        </div>
                        <div class="col-6 text-end">
                            <strong class="text-success fs-5">${{ formatearPrecio(total) }}</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success" :disabled="guardando">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    {{ guardando ? 'Renovando...' : 'Renovar Reserva' }}
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    fechaInicio: '@(Model?.FechaInicio.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))',
                    fechaFin: '@(Model?.FechaFin.ToString("yyyy-MM-dd") ?? DateTime.Now.AddDays(7).ToString("yyyy-MM-dd"))',
                    montoPorDia: @(Model?.MontoPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                    idUsuarioCreador: @(Model?.IdUsuarioCreador ?? 0),
                    errores: {},
                    guardando: false
                }
            },
            computed: {
                dias() {
                    if (!this.fechaInicio || !this.fechaFin) return 0;
                    const inicio = new Date(this.fechaInicio);
                    const fin = new Date(this.fechaFin);
                    const diff = Math.ceil((fin - inicio) / (1000 * 60 * 60 * 24));
                    return diff > 0 ? diff : 0;
                },
                total() {
                    return this.dias * this.montoPorDia;
                }
            },
            methods: {
                formatearPrecio(valor) {
                    return new Intl.NumberFormat('es-AR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }).format(valor || 0);
                },
                validar() {
                    this.errores = {};
                    if (!this.fechaInicio) {
                        this.errores.fechaInicio = "La fecha de inicio es obligatoria.";
                    }
                    if (!this.fechaFin) {
                        this.errores.fechaFin = "La fecha de fin es obligatoria.";
                    }
                    if (this.dias <= 0) {
                        this.errores.fechaFin = "La fecha de fin debe ser posterior a la de inicio.";
                    }
                    return Object.keys(this.errores).length === 0;
                },
                async guardar() {
                    if (!this.validar()) return;
                    this.guardando = true;
                    try {
                        const form = document.querySelector('form');
                        const formData = new FormData(form);
                        formData.set('FechaInicio', this.fechaInicio);
                        formData.set('FechaFin', this.fechaFin);
                        formData.set('MontoPorDia', this.montoPorDia);
                        formData.set('IdUsuarioCreador', this.idUsuarioCreador);

                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            const html = await response.text();
                            document.open();
                            document.write(html);
                            document.close();
                        }
                    } catch (error) {
                        alert('Error de conexión: ' + error.message);
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#app-renovar');
    </script>
}