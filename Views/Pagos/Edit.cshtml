@model InmobiliariaTPI.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<h1>Editar Pago</h1>

<div class="alert alert-info">
    <strong>Nota:</strong> Solo puedes editar el concepto del pago.
</div>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaPago" />
            <input type="hidden" asp-for="Importe" />
            <input type="hidden" asp-for="IdReserva" />
            <input type="hidden" asp-for="Estado" />

            <div class="form-group mb-3">
                <label asp-for="Concepto" class="control-label"></label>
                <input asp-for="Concepto" class="form-control" />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaPago" class="control-label"></label>
                <input asp-for="FechaPago" class="form-control" type="date" disabled />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Importe" class="control-label"></label>
                <input asp-for="Importe" class="form-control" disabled />
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}