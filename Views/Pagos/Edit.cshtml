@model InmobiliariaTPI.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Editar Pago</h1>
        <p class="page-subtitle">Modifica el concepto del pago #@Model.Id</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="alert-soft alert-soft-info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>Solo puedes editar el concepto del pago.</strong>
                <p class="mb-0">Los demas datos no son modificables una vez registrado el pago.</p>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaPago" />
            <input type="hidden" asp-for="Importe" />
            <input type="hidden" asp-for="IdReserva" />
            <input type="hidden" asp-for="Estado" />

            <div class="card form-card">
                <div class="card-header">
                    <i class="bi bi-cash-stack me-2"></i>Datos del Pago
                </div>
                <div class="card-body">

                    <div class="form-group mb-3">
                        <label asp-for="Concepto" class="form-label"></label>
                        <input asp-for="Concepto" class="form-control" />
                        <span asp-validation-for="Concepto" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FechaPago" class="form-label"></label>
                                <input asp-for="FechaPago" class="form-control" type="date" disabled />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Importe" class="form-label"></label>
                                <input asp-for="Importe" class="form-control" disabled />
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
            </div>

        </form>

    </div>
</div>

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #212529;
            margin: 0 0 4px 0;
        }

        .page-subtitle {
            color: #868e96;
            font-size: 0.9rem;
            margin: 0;
        }

        .alert-soft {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 16px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .alert-soft-info {
            background-color: #e3f6fc;
            border: 1px solid #c5edf7;
            color: #055160;
        }

        .alert-soft i {
            font-size: 1.4rem;
            flex-shrink: 0;
            line-height: 1;
        }

        .alert-soft strong {
            display: block;
            font-size: 0.95rem;
            margin-bottom: 2px;
        }

        .alert-soft p {
            font-size: 0.85rem;
            margin: 0;
            opacity: 0.85;
        }

        .form-card {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
        }

        .form-card .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            padding: 14px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #495057;
        }

        .form-card .card-body {
            padding: 24px;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 6px;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: all 0.15s ease;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
        }

        .form-control:disabled {
            background-color: #f8f9fa;
            color: #6c757d;
        }

        .form-actions {
            display: flex;
            gap: 8px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}