@model InmobiliariaTPI.Models.Pago

@{
    ViewData["Title"] = "Detalles del Pago";
}

<h1>Detalles del Pago</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Id)</dd>

        <dt class="col-sm-3">Concepto</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Concepto)</dd>

        <dt class="col-sm-3">Fecha de Pago</dt>
        <dd class="col-sm-9">@Model.FechaPago.ToShortDateString()</dd>

        <dt class="col-sm-3">Importe</dt>
        <dd class="col-sm-9">@Model.Importe.ToString("N2")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            @if (Model.Estado == 1)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-danger">Anulado</span>
            }
        </dd>

        <dt class="col-sm-3">Reserva</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.IdReserva)</dd>

        @if (User.IsInRole("Administrador"))
        {
            <dt class="col-sm-3">Usuario Creador</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.IdUsuarioCreador)</dd>

            @if (Model.IdUsuarioAnulacion.HasValue)
            {
                <dt class="col-sm-3">Usuario Anulación</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.IdUsuarioAnulacion)</dd>

                <dt class="col-sm-3">Fecha Anulación</dt>
                <dd class="col-sm-9">@Model.FechaAnulacion?.ToShortDateString()</dd>
            }
        }

        <dt class="col-sm-3">Fecha Creación</dt>
        <dd class="col-sm-9">@Model.FechaCreacion.ToShortDateString()</dd>
    </dl>
</div>

<div>
    @if (Model.Estado == 1)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Anular" asp-route-id="@Model.Id" class="btn btn-danger">Anular</a>
        }
    }
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>