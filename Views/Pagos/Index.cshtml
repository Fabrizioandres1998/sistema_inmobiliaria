@model IPagedList<InmobiliariaTPI.Models.Pago>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Pagos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@(TempData["Tipo"] ?? "success") alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Pagos</h1>


<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control" placeholder="Buscar por concepto..."
               value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
        {
            <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
        }
    </div>
</form>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Id)</th>
            <th>@Html.DisplayNameFor(model => model.First().Concepto)</th>
            <th>@Html.DisplayNameFor(model => model.First().FechaPago)</th>
            <th>@Html.DisplayNameFor(model => model.First().Importe)</th>
            <th>@Html.DisplayNameFor(model => model.First().Estado)</th>
            <th>Reserva</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Concepto)</td>
                <td>@item.FechaPago.ToShortDateString()</td>
                <td>@item.Importe.ToString("N2")</td>
                <td>
                    @if (item.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Anulado</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.IdReserva)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    @if (item.Estado == 1)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Anular" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Anular</a>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", new
    {
        page,
        pageSize = Model.PageSize,
        searchTerm =
    ViewBag.SearchTerm
    }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>