@model InmobiliariaTPI.Models.Pago

@{
    ViewData["Title"] = "Crear Pago";
}

<h1>Crear Pago</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" name="IdReserva" value="@Model.IdReserva" />

            <div class="form-group mb-3">
                <label class="control-label">Concepto</label>
                <input name="Concepto" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Fecha de Pago</label>
                <input name="FechaPago" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Importe</label>
                <input name="Importe" class="form-control" type="number" step="0.01" required />
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-controller="Reservas" asp-action="Details" asp-route-id="@Model.IdReserva" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}